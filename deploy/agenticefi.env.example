# Copy to /etc/agenticefi/agenticefi.env, root:root 0600. Never put the real key in a release.
META_HACKATHON_API_KEY=
AGENTICEFI_DIAGNOSTICS_DIR=/var/lib/agenticefi/investigation-diagnostics
HOST=127.0.0.1
PORT=3000
BODY_SIZE_LIMIT=16K
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host
SHUTDOWN_TIMEOUT=30
IDLE_TIMEOUT=0
