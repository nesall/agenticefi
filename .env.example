# Server-only example. Dev/preview load .env; restart the server after changing credentials.
# Production uses its service environment or the explicit npm run start:env command.
META_HACKATHON_API_KEY=
HOST=127.0.0.1
PORT=3000
BODY_SIZE_LIMIT=16K
# Only trust these headers when the Node port is private behind your reverse proxy.
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host
